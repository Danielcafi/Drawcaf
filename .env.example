VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Fedapay Configuration
VITE_FEDAPAY_PUBLIC_KEY=your_fedapay_public_key_here
VITE_FEDAPAY_RETURN_URL=https://your-domain.com/payment/callback

# NOTE: FEDAPAY_SECRET_KEY is configured as a Supabase Edge Function secret
# Run: npx supabase secrets set FEDAPAY_SECRET_KEY=your_secret_key_here
